# Never put real secrets in this example or in website/.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
HOST=127.0.0.1
PORT=4179
# Required for NODE_ENV=production (at least 16 characters).
